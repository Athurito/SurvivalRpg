  "decisions": {
    "2026-10-14": [
      "standing turn in place in the combat stance belongs to GASP-13 and comes first",
      "armor Foley leaves GASP-13 for GASP-16 or its own audio package"
    ]
  },
  "cause": {
    "gate": "ShouldTurnInPlace (unchanged GASP function) offers the turn-in-place database only while WantsToAim or in the frame after a stop; BP_RpgGasp_CMC reports the stance as WantsToStrafe and WantsToAim as constant false",
    "cost": "with the gate open, DoNotInterrupt kept the continuing idle pose; the Relaxed turn database has base cost bias 0 (Dense: -0.2 against +0.1 on idles), so the idle loop won",
    "crouch": "the CMC chooser's crouch-idle table offered the crouch idles together with the crouch turns",
    "rejected_hypothesis": "GASP-10 chooser swap; the shared Dense chooser gates its turn row the same way, and the 2026-09-27 turn clips came from the reverted GASP-06 condition change"
  },
  "fix": {
    "ABP_RpgGasp_CMC.ShouldTurnInPlace": "also true in the strafe rotation mode",
    "ABP_RpgGasp_CMC.Get_MMInterruptMode": "InterruptOnDatabaseChange while ShouldTurnInPlace, standing still, and the current database is not tagged TurnInPlace",
    "CHT_RpgGasp_CMC_PoseSearchDatabases.Crouch Idle": "row 0 (crouch idles) requires ShouldTurnInPlace false",
    "ABP_RpgGasp_CMC.MotionMatching.PoseReselectHistory": "0.3 -> 0.4",
    "DA_PawnData_GaspCMC.DefaultCameraMode": "CM_ThirdPerson -> CM_RpgGasp_Traversal (PositionDampingFactor 20 rad/s)",
    "unchanged_after_measurement": {
      "Steering.ProceduralTargetTime": "0.4 (0.5 slid more on a run snap)",
      "ShouldSpinTransition speed gate": "150 cm/s (300 removed walk spins but walk snaps slid more)",
      "OffsetRootBone.RotationHalfLife": "0.1 (used only in Release/Interpolate; the CMC uses Accumulate except during DefaultSlot montages)"
    }
  },
