{
  "task": "GASP-STAB-04",
  "date": "2026-10-13",
  "engine": "5.8.3",
  "cause": {
    "deferred_transform": "UCharacterMovementComponent::ServerMove_PerformMovement wraps PlayerController::UpdateRotation and MoveAutonomous in FScopedCapsuleMovementUpdate (deferred). The capsule turns at once; its child mesh follows only when the scope ends. MoveAutonomous ticks the pose inside the scope (TickCharacterPose), so UAnimInstance::PreUpdateAnimation caches the mesh transform from before the move in the anim proxy. FAnimInstanceProxy::PreEvaluateAnimation re-caches it only while root motion plays. Offset Root Bone evaluates against the cached transform and holds the root one move behind the rendered mesh.",
    "evidence_deferred_transform": "smoothing off: per frame, server root yaw step = capsule yaw step of this frame minus that of the previous frame (to three decimals); the AnimBP CharacterTransform (actor) was current at the same time",
    "rotation_smoothing": "listen-server smoothing (SmoothCorrection after the pose tick, exponential, rotation time 0.033 s) moves the rendered mesh after the transform was cached; with Offset Root Bone the root follows that offset. At 120 FPS the client sends moves every second frame, which makes a sawtooth. At 30 FPS a 33 ms frame exceeds 0.033 s and the rotation snaps.",
    "not_the_cause": "several pose updates per evaluation: at 60 FPS the server applied one move per frame in 163 of 164 frames and still jittered"
  },
  "fix": {
    "native": "URpgAnimInstance::PreUpdateAnimation calls GetSkelMeshComponent()->UpdateComponentToWorld() before Super while IsRemoteAutonomousPoseTick (listen server, authority, remote autonomous owner, bOnlyAllowAutonomousTickPose and bIsAutonomousTickPose), the scope already used by CanRunParallelWork",
    "asset": {
      "path": "/Game/SurvivalRpg/Characters/GASP/CMC/RPG/BP_RpgGasp_CMC",
      "change": "CharacterMovement ListenServerNetworkSimulatedSmoothRotationTime 0.033 -> 0; ListenServerNetworkSimulatedSmoothLocationTime stays 0.04",
      "inherited_by": [
        "BP_RpgGasp_MantleCharacter",
        "BP_RpgGasp08_CMC_Manny",
        "BP_RpgGasp08_CMC_UefnFollower",
        "BP_RpgGasp08_CMC_UefnControl"
      ],
      "unchanged": "ARpgCharacter class default (0.033) for pawns without Offset Root Bone"
    }
  },
